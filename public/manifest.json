{
  "manifest_version": 3,
  "name": "DeskTab",
  "short_name": "DeskTab",
  "version": "1.0",
  "description": "DeskTab turns your new tab into a clean, Mac-inspired desktop for shortcuts and quick access.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "DeskTab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}
